# Copy to .env for the environment that runs Django. Never commit real values.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

POSTGRES_DB=emergency_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-the-database-password
POSTGRES_HOST=postgres.example.internal
POSTGRES_PORT=5432

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=notifications@example.com

TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_PHONE_NUMBER=replace-with-twilio-number
TWILIO_SMS_CONTENT_SID=
TWILIO_USE_TRIAL_TEMPLATES=false
TWILIO_TRIAL_SMS_TEMPLATE=sms_internal_alerts

# Optional Firebase push delivery. Place service-account.json under config/ only
# through the deployment secret manager; do not commit that file.
